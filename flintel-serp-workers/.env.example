# ───────────── MongoDB ─────────────
# Jobs yahan se PADHI jati hain (flintel_search_jobs) — chatbot wala MONGODB3 + MONGODB_DB
MONGODB3=mongodb+srv://user:pass@host/?retryWrites=true
MONGODB_DB=flintel
# flintel_google_posts yahan likhi jati hain (commerce-agent wala MONGODB2_URI / MONGODB2_DB).
# Set na ho to MONGODB3 / MONGODB_DB use hote hain.
MONGODB2_URI=
MONGODB2_DB=

# ───────────── RapidAPI (google-search116) ─────────────
RAPIDAPI_KEY=
# Ek second mein max kitni API calls shuru hon (0 = bina limit). 100 workers ek saath bhi chalenge,
# bas calls is raftaar se nikalengi taake RapidAPI 429 na de. Apne plan ke hisaab se barhayein.
RAPIDAPI_MAX_RPS=10

# ───────────── Workers ─────────────
WORKERS=100                 # kitne employees (parallel jobs ek round mein)
POLL_SECONDS=10             # koi job na ho to itni der baad dobara dekhein
RECENT_HOURS=24             # sirf last N ghante ke posts: Google ka tbs param (<=1h qdr:h, <=24h qdr:d, <=7d qdr:w). 0 = band
RECENT_TBS=                 # chahein to seedha tbs value likhein (jaise qdr:d); khali = RECENT_HOURS se
JOB_MAX_AGE_HOURS=24        # sirf itne naye jobs uthayein (requested_at). 0 = koi limit nahi
JOB_PLATFORMS=all,reddit    # jin targeting_platform wale jobs uthane hain
KEYWORDS_PER_CALL=2         # ek job ke keywords ek API call mein (OR query); chatbot/commerce-agent bhi 2 use karte hain. Google ~32 words tak hi padhta hai
MAX_KEYWORDS_PER_JOB=20
RESULTS_PER_KEYWORD=10      # limit = ye * keywords us call ke
MAX_ATTEMPTS=3              # fail job kitni baar dobara try ho
STALE_SECONDS=600           # claimed/processing job itni der heartbeat na de to wapas utha li jati hai
SERP_TIMEOUT_SECONDS=30
SERP_MAX_RETRIES=3

# ───────────── Status page ─────────────
STATUS_SERVER_ENABLED=true
PORT=8080

# ───────────── Collections ─────────────
JOBS_COLLECTION=flintel_search_jobs
POSTS_COLLECTION=flintel_google_posts
RUNS_COLLECTION=flintel_serp_job_runs
STATUS_COLLECTION=flintel_serp_worker_status
